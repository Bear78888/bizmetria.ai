# Public application configuration
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=https://rbndiytodvoyiejassnw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Canonical, non-secret database target guard.
# Production must always use the canonical ref. A registered isolated dev/preview
# project is accepted ONLY together with SUPABASE_TARGET_ENV=preview (below); the
# wrong-project incident refs are never accepted.
SUPABASE_PROJECT_REF=rbndiytodvoyiejassnw

# Leave unset for production/canonical. Set to `preview` ONLY on an isolated,
# data-less development/preview deployment whose SUPABASE_PROJECT_REF and
# NEXT_PUBLIC_SUPABASE_URL both point at a ref registered in
# src/lib/supabase/target.ts (REGISTERED_PREVIEW_PROJECT_REFS).
# SUPABASE_TARGET_ENV=preview

# Explicitly opt in only after the URL, ref, and both project keys are verified.
ASSESSMENT_STORAGE_MODE=mock

# Pins the analysis provider. `claude` demands a working ANTHROPIC_API_KEY;
# `deterministic` runs the offline provider and never calls out. Leave unset to
# use Claude whenever a key is present.
# ANALYSIS_PROVIDER=claude

# Set to `send` to actually deliver result email through Resend.
# RESEND_DELIVERY_MODE=send

# Server-only service credentials
SUPABASE_SECRET_KEY=
# Claude is the analysis provider. Without this key the analysis falls back to
# the deterministic offline provider; the paid assessment requires the key.
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
RETELL_API_KEY=
RESEND_API_KEY=

# Provisioned during later sandbox implementation stages
STRIPE_PRODUCT_ID=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
RETELL_WEBHOOK_API_KEY=
RETELL_ENGLISH_AGENT_ID=
RETELL_SPANISH_AGENT_ID=
RETELL_ENGLISH_PHONE_NUMBER=
RETELL_SPANISH_PHONE_NUMBER=
RESEND_FROM_EMAIL=noreply@bizmetria.com
RESEND_REPLY_TO_EMAIL=
RESEND_WEBHOOK_SECRET=
ADMIN_EMAILS=
INTERNAL_WEBHOOK_SECRET=
CRON_SECRET=
DATA_ENCRYPTION_KEY=
