{
  "name": "bizmetria-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bilingual BizMetria Business Assessment platform",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "verify:supabase-target": "node --experimental-strip-types scripts/verify-supabase-target.ts",
    "supabase:link": "supabase link --project-ref rbndiytodvoyiejassnw && npm run verify:supabase-target",
    "supabase:migrate": "npm run verify:supabase-target && supabase db push",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run format && npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "stripe": "^22.4.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
